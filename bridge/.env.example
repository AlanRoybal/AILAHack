# Bridge port. The lens app's dev server proxies /bridge here.
PORT=8787
# Optional shared secret the lens must send in hello.
HANDOFF_TOKEN=
GEMINI_API_KEY=
# Fast model for spotting tasks in speech, and the model that drives the browser.
DETECT_MODEL=gemini-3.5-flash-lite
AGENT_MODEL=gemini-3.5-flash
DEEPGRAM_API_KEY=
# Chrome started with --remote-debugging-port, logged into the demo accounts.
CDP_URL=http://localhost:9222
# Google Slides deck the demo edits, and the Apps Script web app bound to it (slides/Code.gs).
SLIDES_URL=
SLIDES_SCRIPT_URL=
# Where restaurant searches start.
CITY=Westwood, Los Angeles
# 1 = click "Complete reservation" at the end. Off by default so demos never book.
OPENTABLE_SUBMIT=0
CITY_LAT=34.0635
CITY_LNG=-118.4455
