{
  "name": "booth-brief-lens",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "pack": "npm run build && evenhub pack app.json dist -o booth-brief.ehpk",
    "simulate": "evenhub-simulator http://localhost:5174",
    "qr": "evenhub qr --url http://$(ipconfig getifaddr en0 || hostname -I | cut -d' ' -f1):5174"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.16"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.1.14",
    "@evenrealities/evenhub-simulator": "^0.9.5",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
