PORT=8790
# App-scoped key from the agent's API Trigger panel on agent.creao.ai (capi_...).
CREAO_API_KEY=
# The Booth Brief agent's id on agent.creao.ai.
# Developer Platform project key (cr_sk_) + agent from `npm run setup`, or an agent key (capi_) + that agent's app ID.
CREAO_AGENT_ID=
APOLLO_API_KEY=
# Name of the agent's single text input.
CREAO_INPUT_FIELD=request
# Follow-ups go here unless SEND_TO_REP=1.
# Gmail send Lambda from ../mailer/deploy.sh and its bearer token
MAILER_URL=
MAILER_TOKEN=
TEST_EMAIL=
SEND_TO_REP=0
# Speech to text for the spoken rep name.
DEEPGRAM_API_KEY=
# How long the lens shows "sending in Ns" before CREAO sends.
COUNTDOWN_MS=8000
